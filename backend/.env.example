# Copier en .env et ajuster. Ne jamais versionner le .env réel.

# --- Passerelle Jasmin ---
# En production : l'adresse de la passerelle (ex. 192.168.1.70).
# En local avec tools/jasmin_simulator.py : 127.0.0.1
JASMIN_HOST=127.0.0.1
JASMIN_JCLI_PORT=8990
JASMIN_HTTP_PORT=1401
JASMIN_AMQP_PORT=5672
JASMIN_USERNAME=jcliadmin
JASMIN_PASSWORD=changeme

# Délai des appels jcli et HTTP, en secondes.
# 3 suffit en local ; remonter à 30 face à une vraie passerelle distante.
JASMIN_TIMEOUT=3
